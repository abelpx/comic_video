# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidcraft_studio
DB_USER=root
DB_PASSWORD=vidcraft_password
DB_SSLMODE=disable

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=vidcraft-studio

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE=86400

# RabbitMQ配置
RABBITMQ_URL=amqp://vidcraft_user:vidcraft_password@localhost:5672/

# 文件上传配置
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads
TEMP_PATH=./temp
OUTPUT_PATH=./output

# 视频处理配置
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_CONCURRENT_RENDERS=5

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 跨域配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000 

# AI模型服务地址
SD_ENDPOINT=http://127.0.0.1:7860
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:14b
WHISPER_ENDPOINT=http://127.0.0.1:9000
TTS_ENDPOINT=http://127.0.0.1:50021

# SD生成配置
SD_TIMEOUT=300s
SD_MAX_RETRIES=3
SD_RETRY_DELAY=10s
ENABLE_PROMPT_TRANSLATION=false
SD_USE_CHINESE_PROMPTS=true # true 使用中文提示词, false 使用英文提示词

# 新增AI服务配置
VIDEO_GEN_ENDPOINT=http://127.0.0.1:8000
MUSIC_GEN_ENDPOINT=http://127.0.0.1:8001
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=1800s