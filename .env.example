# VidCraft Studio 环境配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# 应用配置
APP_NAME=VidCraft Studio
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# 数据库配置
DATABASE_URL=postgres://root:vidcraft_password@localhost:5432/vidcraft_studio?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=vidcraft_password
DB_NAME=vidcraft_studio

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=vidcraft
MINIO_USE_SSL=false

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# AI服务配置
# Ollama配置
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_API_KEY=

# Stable Diffusion配置
SD_ENDPOINT=http://127.0.0.1:7860
SD_TIMEOUT=300s
SD_MAX_RETRIES=3
SD_RETRY_DELAY=10s
ENABLE_PROMPT_TRANSLATION=false
SD_USE_CHINESE_PROMPTS=true

# 语音服务配置
WHISPER_ENDPOINT=http://127.0.0.1:9000
TTS_ENDPOINT=http://127.0.0.1:8000

# 新增AI服务配置
VIDEO_GEN_ENDPOINT=http://127.0.0.1:8000
MUSIC_GEN_ENDPOINT=http://127.0.0.1:8001
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=1800s

# 文件上传配置
MAX_UPLOAD_SIZE=100MB
ALLOWED_FILE_TYPES=mp4,avi,mov,wmv,flv,webm,mkv,jpg,jpeg,png,gif,bmp,webp,mp3,wav,aac,flac,ogg

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=VidCraft Studio <noreply@vidcraft.com>

# 第三方服务配置（可选）
# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Bilibili API
BILIBILI_APP_KEY=your-bilibili-app-key
BILIBILI_APP_SECRET=your-bilibili-app-secret

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# 微博API
WEIBO_APP_KEY=your-weibo-app-key
WEIBO_APP_SECRET=your-weibo-app-secret

# 监控和日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
ENABLE_METRICS=true
METRICS_PORT=9090

# 缓存配置
CACHE_TTL=3600
CACHE_PREFIX=vidcraft:

# 安全配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s

# 开发配置
HOT_RELOAD=true
API_DOCS_ENABLED=true
SWAGGER_HOST=localhost:8080

# 生产环境配置（生产环境时启用）
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem
# ENABLE_HTTPS=true
# TRUSTED_PROXIES=127.0.0.1

# 性能配置
MAX_WORKERS=10
QUEUE_SIZE=1000
BATCH_SIZE=50
TIMEOUT=30s

# 功能开关
ENABLE_USER_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_SOCIAL_LOGIN=false
ENABLE_PAYMENT=false
ENABLE_ANALYTICS=true

# 配额限制
DEFAULT_USER_QUOTA=1000
PREMIUM_USER_QUOTA=10000
MAX_PROJECT_COUNT=50
MAX_VIDEO_DURATION=600

# 存储配置
TEMP_DIR=temp
OUTPUT_DIR=output
UPLOAD_DIR=uploads
STATIC_DIR=static

# 视频处理配置
DEFAULT_VIDEO_QUALITY=1080p
SUPPORTED_FORMATS=mp4,webm,avi
MAX_VIDEO_SIZE=500MB
FFMPEG_PATH=ffmpeg

# AI模型配置
DEFAULT_IMAGE_MODEL=stable-diffusion-v1-5
DEFAULT_VOICE_MODEL=tts-1
DEFAULT_MUSIC_MODEL=musicgen-small
MODEL_CACHE_SIZE=5GB
